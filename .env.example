# ── Resend (envio de emails do formulário de contacto) ─────────────────────────
# Obtém em https://resend.com → Settings → API Keys → Create API Key
RESEND_API_KEY=

# Remetente. Antes da verificação de domínio, manter "MareDatum <onboarding@resend.dev>".
# Após verificação de maredatum.pt no Resend, mudar para "MareDatum <noreply@maredatum.pt>".
CONTACT_FROM_EMAIL=MareDatum <onboarding@resend.dev>

# Destinatário das mensagens do formulário.
CONTACT_TO_EMAIL=geral@maredatum.pt

# ── Upstash Redis (rate-limit do formulário de contacto) ───────────────────────
# Cria em https://upstash.com → Console → Create Database (Redis, free tier).
# Copia "REST URL" e "REST Token" da página da base de dados.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── cPanel FTP (deploy do site estático) ──────────────────────────────────────
# Em cPanel → Files → FTP Accounts. Cria uma conta com home dir public_html
# OU usa as credenciais cPanel principais (mesmo username/password do login).
CPANEL_FTP_HOST=maredatum.pt
CPANEL_FTP_USER=maredatum
CPANEL_FTP_PASS=
# Opcionais
# CPANEL_FTP_PORT=21
# CPANEL_REMOTE_DIR=public_html
