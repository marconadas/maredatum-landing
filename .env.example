# ── SMTP Microsoft 365 / Outlook (envio de emails do formulário) ───────────────
# Autentica como a mailbox geral@maredatum.pt e envia directamente.
# Se a conta tiver MFA, cria uma "app password" em Microsoft 365.
# SMTP AUTH tem de estar activo no tenant (Admin → Settings → Mail flow).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=geral@maredatum.pt
SMTP_PASS=

# Remetente e destinatário. FROM tem de ser a própria mailbox autenticada.
CONTACT_FROM_EMAIL=MareDatum <geral@maredatum.pt>
CONTACT_TO_EMAIL=geral@maredatum.pt

# ── Upstash Redis (rate-limit do formulário de contacto) ───────────────────────
# Cria em https://upstash.com → Console → Create Database (Redis, free tier).
# Copia "REST URL" e "REST Token" da página da base de dados.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── cPanel FTP (deploy do site estático) ──────────────────────────────────────
# Em cPanel → Files → FTP Accounts. Cria uma conta com home dir public_html
# OU usa as credenciais cPanel principais (mesmo username/password do login).
CPANEL_FTP_HOST=maredatum.pt
CPANEL_FTP_USER=maredatum
CPANEL_FTP_PASS=
# Opcionais
# CPANEL_FTP_PORT=21
# CPANEL_REMOTE_DIR=public_html
